  m_Script: {fileID: 11500000, guid: 828d97c8aa6051b4bb7f2d1d306581bb, type: 3}
  m_Name: SampleGenshinCutscene
  m_EditorClassIdentifier: Assembly-CSharp::DialogueSequence
  sequenceTitle: Paimon and Teucer's Money
  lines:
  - speakerName: Paimon
    speakerColor: {r: 1, g: 0.79, b: 0.22, a: 1}
    dialogueText: Cool! Suddenly, Paimon doesn't feel so bad about taking Teucer's
      money!
    voiceClip: {fileID: 0}
    cameraFocus: {fileID: 0}
  - speakerName: Traveler
    speakerColor: {r: 0.92, g: 0.92, b: 0.96, a: 1}
    dialogueText: Hey, don't say that! We should be more considerate.
    voiceClip: {fileID: 0}
    cameraFocus: {fileID: 0}
  - speakerName: Paimon
    speakerColor: {r: 1, g: 0.79, b: 0.22, a: 1}
    dialogueText: Hehe, Paimon was just kidding! Let's get going, there's an adventure
      waiting for us!
    voiceClip: {fileID: 0}
    cameraFocus: {fileID: 0}
